{
  "name": "sudokug",
  "version": "1.0.0",
  "description": "SudokuG: sudoku player and generator with human-style hints and puzzles without grind",
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs",
    "test": "esbuild test/engine.test.ts --bundle --platform=node --outfile=dist/test.cjs --log-level=warning && node dist/test.cjs",
    "typecheck": "tsc --noEmit",
    "dailies": "esbuild scripts/make-dailies.ts --bundle --platform=node --outfile=dist/dailies.cjs --log-level=warning && node dist/dailies.cjs",
    "library": "esbuild scripts/make-library.ts --bundle --platform=node --outfile=dist/library.cjs --log-level=warning && node dist/library.cjs",
    "add-likes": "esbuild scripts/add-likes.ts --bundle --platform=node --outfile=dist/add-likes.cjs --log-level=warning && node dist/add-likes.cjs",
    "grow": "esbuild scripts/grow.ts --bundle --platform=node --outfile=dist/grow.cjs --log-level=warning && node dist/grow.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
